pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: '1',
            description: 'Versión de techstore-web construida en DEV que se promoverá a STAGE'
        )
    }

    stages {

        stage('Validate') {
            steps {
                echo "Promoviendo techstore-web:${params.IMAGE_VERSION} a STAGE..."

                sh 'test -f environments/stage/compose.yaml'
            }
        }

        stage('Verify Image') {
            steps {
                echo "Verificando que techstore-web:${params.IMAGE_VERSION} existe..."

                sh """
                    docker image inspect techstore-web:${params.IMAGE_VERSION}
                """
            }
        }

        stage('Deploy STAGE') {
            steps {
                echo 'Desplegando versión en STAGE...'

                sh """
                    WEB_IMAGE=techstore-web:${params.IMAGE_VERSION} \
                    docker compose \
                    -f environments/stage/compose.yaml \
                    -p techstore-stage \
                    up -d
                """

                echo 'Despliegue en STAGE completado.'
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Ejecutando smoke test de STAGE...'

                sh '''
                    sleep 3
                    curl -f http://localhost:8083
                '''
            }
        }
    }

    post {

        success {
            echo "STAGE actualizado correctamente con techstore-web:${params.IMAGE_VERSION}"
        }

        failure {
            echo 'El pipeline de STAGE ha fallado.'
        }

    }
}
